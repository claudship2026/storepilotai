# ---------- Database ----------
# Neon or Supabase Postgres connection string (pooled connection is fine)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# ---------- Auth ----------
# Single admin operator. Generate the hash with: npm run hash -- "your-password"
ADMIN_EMAIL="you@example.com"
# OPTIONAL. Leave this out entirely and the app shows a one-time password setup
# screen on first visit, which is the easy path when deploying without a terminal.
# If you do set it: run `npm run hash -- "your-password"` and paste the line
# exactly as printed. The $ signs must stay escaped as \$ or Next truncates it.
# ADMIN_PASSWORD_HASH="\$2a\$12\$replace_me_with_output_of_npm_run_hash"
# 32+ random chars. Generate with: openssl rand -base64 48
SESSION_SECRET="replace_me_with_a_long_random_string"

# ---------- Claude ----------
ANTHROPIC_API_KEY="sk-ant-..."
# Frontier tier: drafting, research analysis, creative
CLAUDE_MODEL_FRONTIER="claude-sonnet-4-5"
# Cheap tier: classification, extraction, scoring
CLAUDE_MODEL_CHEAP="claude-haiku-4-5"
# Hard monthly ceiling in USD. Breaker trips agent invocation, never external writes.
AI_MONTHLY_BUDGET_USD="50"

# ---------- Shopify (Phase 4 - leave blank until then) ----------
SHOPIFY_STORE_DOMAIN=""
SHOPIFY_ADMIN_ACCESS_TOKEN=""
SHOPIFY_API_SECRET=""
SHOPIFY_API_VERSION="2025-07"

# ---------- Ops ----------
NODE_ENV="development"
APP_URL="http://localhost:3000"
SENTRY_DSN=""

# Set on Vercel to match SESSION_SECRET so scheduled syncs authenticate.
CRON_SECRET=""
